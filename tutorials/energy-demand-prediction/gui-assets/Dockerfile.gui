# Energy Demand GUI — nginx + Vite 빌드
#
# ## 실행 시 구성
#
# nginx 설정은 이미지에 **템플릿**으로 들어가고, 컨테이너가 뜰 때 렌더된다.
#
#   /docker-entrypoint.d/16-runway-creds.envsh   OpenBao 가 넣어 준 /vault/secrets/creds.env 를 읽어 env 로 올림
#   /docker-entrypoint.d/20-envsubst-on-templates.sh   (nginx 기본) 템플릿의 ${RUNWAY_*} 치환
#
# 자격 증명을 이미지에 굽지 않는 이유다 — 프로젝트마다 값이 다르고, 이미지는 공유된다.

FROM node:20-alpine AS build
WORKDIR /app
COPY gui/package*.json ./
RUN npm install
COPY gui/ ./
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY gui/default.conf.template /etc/nginx/templates/default.conf.template
COPY gui/16-runway-creds.envsh /docker-entrypoint.d/16-runway-creds.envsh
RUN chmod +x /docker-entrypoint.d/16-runway-creds.envsh
EXPOSE 80
